<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 遮罩模式（零依赖降级方案）需要悬浮窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:ignore="ProtectedPermissions" />

    <!-- 前台服务：保持遮罩层不被回收 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name_full"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Inkwell">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name_full"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 静态快捷方式：装完就有，长按桌面图标即可出现，无需先打开一次 App -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          透明快捷动作执行器。
          桌面图标 / 长按快捷方式 / 通知栏 Action 都指向它，
          执行完立刻 finish()，不显示任何界面。
        -->
        <activity
            android:name=".QuickActionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="com.inkwell.mode.QUICK_ACTION" />
                <action android:name="com.inkwell.mode.QUICK_ACTION.toggle" />
                <action android:name="com.inkwell.mode.QUICK_ACTION.original" />
                <action android:name="com.inkwell.mode.QUICK_ACTION.color_paper" />
                <action android:name="com.inkwell.mode.QUICK_ACTION.ink_paper" />
                <action android:name="com.inkwell.mode.QUICK_ACTION.restore" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".QuickActivity"
            android:exported="false"
            android:label="快捷按钮"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PresetActivity"
            android:exported="true"
            android:label="显示模式"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait">
            <!-- 长按 QS 磁贴 → 直接进三模选择页（系统跨进程调用，需 exported） -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RulesActivity"
            android:exported="false"
            android:label="按 App 指定模式"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".DiagActivity"
            android:exported="false"
            android:label="诊断与关于"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <!--
          控制中心快捷开关（系统快捷开关）：不用打开 App 就能切模式。
          TOGGLEABLE + CATEGORY_DISPLAY 让 Android 13+ 把它当「显示类开关」渲染，
          和护眼模式、深色模式同组同样式；老版本忽略这两个 meta-data，行为不变。
          长按走 QS_TILE_PREFERENCES → PresetActivity（已在上面声明）。
        -->
        <service
            android:name=".EinkTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="墨境"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_DISPLAY" />
        </service>

        <!-- 遮罩引擎（零依赖降级方案）：无 root / 无 Shizuku 时使用 -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="保持纸感遮罩层" />
        </service>

        <!-- Shizuku 授权结果回调 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Xposed / LSPosed 模块声明 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="墨境 Inkwell —— 在 system_server 注入全局色彩矩阵，把屏幕变成彩色墨水屏。零开销、开机生效" />
        <meta-data
            android:name="xposedminversion"
            android:value="53" />
        <!-- 推荐作用域：系统框架（system_server / android） -->
        <meta-data
            android:name="xposedscope"
            android:value="android" />
    </application>

</manifest>
