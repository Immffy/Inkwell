<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name_full"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Inkwell">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name_full"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PresetActivity"
            android:exported="false"
            android:label="预设与微调"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".RulesActivity"
            android:exported="false"
            android:label="按 App 切黑白档"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".DiagActivity"
            android:exported="false"
            android:label="诊断与关于"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait" />

        <!-- 通知栏快捷开关：不用打开 App 就能恢复原色 -->
        <service
            android:name=".EinkTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="墨境"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Xposed / LSPosed 模块声明 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="墨境 Inkwell —— 在 system_server 注入全局色彩矩阵，把屏幕变成彩色墨水屏。零开销、开机生效" />
        <meta-data
            android:name="xposedminversion"
            android:value="53" />
        <!-- 推荐作用域：系统框架（system_server / android） -->
        <meta-data
            android:name="xposedscope"
            android:value="android" />
    </application>

</manifest>
