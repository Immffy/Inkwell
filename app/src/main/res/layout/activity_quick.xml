<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3EE"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#EDE9E0"
            android:fitsSystemWindows="true"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="快捷按钮"
            app:titleTextColor="#222222" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:text="当前状态：读取中"
                android:textColor="#2C5F3D"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- ① 系统快捷开关（本次新增，用户最想要的） -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="① 系统快捷开关（推荐）"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:text="把「墨境」直接写进控制中心的快捷开关列表，和护眼模式、深色模式并列。\n\n点按 → 切换开 / 关　　长按 → 进显示模式页\n加入后仍可在「编辑与排序」里拖动排序或移除，和系统自带开关完全一样。\n\n需要 root 授权（Magisk / KernelSU 弹窗时点允许）。写入只追加一项，不改其它磁贴的顺序。"
                android:textColor="#555555"
                android:textSize="11.5sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:id="@+id/tvTileState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#E8F3EA"
                android:padding="10dp"
                android:text="正在检查是否已加入…"
                android:textColor="#2C5F3D"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/btnInstallTile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="一键加入系统快捷开关" />

            <Button
                android:id="@+id/btnUninstallTile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="从系统快捷开关移除" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FFF4E5"
                android:padding="12dp"
                android:text="没有 root？手动加一样有效：\n下拉控制中心 → 编辑（铅笔）→ 在「系统快捷开关」区域往下滚 → 找到「墨境」点 + → 完成。\n\n此前说「澎湃 OS 不列第三方磁贴」是误判，已更正：HyperOS 读的是同一个 sysui_qs_tiles，第三方磁贴以 custom(包名/类名) 形式参与其中，只是列表长、常要往下滚，装完 App 后偶尔还要刷新一次 SystemUI 才重新枚举。"
                android:textColor="#7A5B1E"
                android:textSize="11.5sp"
                android:lineSpacingExtra="3dp" />

            <!-- ② 桌面快捷按钮 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="② 桌面快捷按钮"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="在桌面生成独立图标，点一下直接切模式。每个按钮会弹一次系统确认框，确认后桌面上就多一个图标，可长按拖动摆放。"
                android:textColor="#777777"
                android:textSize="11.5sp"
                android:lineSpacingExtra="2dp" />

            <Button
                android:id="@+id/btnPinToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="添加「开 / 关」到桌面" />

            <Button
                android:id="@+id/btnPinOriginal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="添加「原色（恢复默认）」到桌面" />

            <Button
                android:id="@+id/btnPinColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="添加「彩纸」到桌面" />

            <Button
                android:id="@+id/btnPinInk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="添加「墨纸」到桌面" />

            <!-- ③ 通知栏 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="③ 通知栏快捷按钮"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="下拉通知栏就能看到「原色 / 彩纸 / 墨纸 / 开·关」四个按钮，最接近护眼模式的体验。常驻通知不响铃、不震动，默认关闭。"
                android:textColor="#777777"
                android:textSize="11.5sp"
                android:lineSpacingExtra="2dp" />

            <Button
                android:id="@+id/btnNotifyToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="常驻通知：已关闭（点击开启）" />

            <!-- ④ 长按图标 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="④ 长按 App 图标"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:text="装好就有，无需设置：在桌面长按「墨境」图标，会弹出 4 个快捷方式 —— 开/关、原色、彩纸、墨纸。也可以把其中某个直接拖到桌面变成独立图标。\n\n这是 Android 静态快捷方式，澎湃 OS 桌面支持。"
                android:textColor="#555555"
                android:textSize="11.5sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#E8E4DA"
                android:padding="12dp"
                android:text=""
                android:textColor="#444444"
                android:textSize="11.5sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
