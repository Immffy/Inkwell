<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3EE"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#EDE9E0"
        android:fitsSystemWindows="true"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="诊断与关于"
        app:titleTextColor="#222222" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="通道状态"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChannels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:text=""
                android:textColor="#444444"
                android:textSize="11.5sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="开关指令通过广播直达 system_server，root-free 且即时。有 root 时额外写 setprop / 配置文件，用于重启后保持上次选择。\n\nAndroid 16 的 SELinux 不允许普通 App 直接写 /data/system 或 /data/local/tmp，所以「文件通道未写入」只代表没给 su 授权，不代表开关失效。"
                android:textColor="#888888"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />

            <Button
                android:id="@+id/btnOverlayToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="降级遮罩：已关闭（点击开启）" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="遮罩默认关闭。已 root / 已装 LSPosed 的机器不需要它；只有给无 root 手机临时体验时才开。"
                android:textColor="#999999"
                android:textSize="10.5sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="自测"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTestRaw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="测试 1015：直接下发矩阵" />

            <Button
                android:id="@+id/btnResetRaw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="恢复：1015 i32 0" />

            <Button
                android:id="@+id/btnCopyDiag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="复制诊断信息" />

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:text=""
                android:textColor="#555555"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="排查顺序"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:text="① LSPosed 作用域勾「系统框架」和「墨境」本身，重启\n② 模块状态显示已激活 ✓\n③ 若已 root，在 Magisk / KernelSU 给墨境授权 su\n④ LSPosed 日志搜 Inkwell，应有 applied\n⑤ 屏幕实际效果变了没\n⑥ 天玑机型：护眼/真彩/AI 画质引擎是否已关"
                android:textColor="#555555"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="关于"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:text=""
                android:textColor="#666666"
                android:textSize="11.5sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
