<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3EE"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- 标题栏：fitsSystemWindows 让系统自动补状态栏高度，避免与导航栏重叠 -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#EDE9E0"
            android:fitsSystemWindows="true"
            app:title="墨境"
            app:titleTextColor="#222222" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp">

            <!-- 状态卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvModule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="模块状态：检测中"
                    android:textColor="#C0392B"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRoot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="root：检测中"
                    android:textColor="#888888"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tvState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="效果：开启中"
                    android:textColor="#1E8449"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="模式：彩纸模式"
                    android:textColor="#2C5F3D"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEngine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="通道：检测中"
                    android:textColor="#555555"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEngineDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />

                <Button
                    android:id="@+id/btnEngine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text=""
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="#E8E4DA"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="v0.0.0"
                    android:textColor="#777777"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 总开关 + 恢复默认 -->
            <Button
                android:id="@+id/btnToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="关闭墨水屏效果"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRestore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#C0392B"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="恢复默认显示（立刻变回原色）"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="「恢复默认」会立刻下发单位矩阵，屏幕马上变回正常颜色，且重启后保持关闭。如果按了没反应，去「诊断」页看原因。"
                android:textColor="#888888"
                android:textSize="11sp" />

            <!-- 功能入口 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="设置"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPreset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="显示模式（原色 / 彩纸 / 墨纸）" />

            <Button
                android:id="@+id/btnRules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="按 App 指定模式" />

            <Button
                android:id="@+id/btnQuick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="快捷按钮（桌面图标 / 通知栏 / 磁贴）" />

            <Button
                android:id="@+id/btnDiag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="诊断与关于" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#FFF4E5"
                android:padding="10dp"
                android:text="原理：在系统进程注入全局色彩矩阵，一屏三模（原色 / 彩纸 / 墨纸）。零延迟、零耗电、开机自动生效。\n\n局限：这是软件调色，不是电子墨水屏。AG 防眩光是硬件蚀刻，纸纹颗粒和局部压高光是非线性变换，色彩矩阵都做不到。"
                android:textColor="#7A5B1E"
                android:textSize="11.5sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
