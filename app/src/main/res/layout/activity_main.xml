<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name_full"
                android:textColor="#111111"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E8E8E8"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="v0.0.0"
                android:textColor="#666666"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvModule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="模块状态：检测中"
            android:textColor="#C0392B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="root：检测中"
            android:textColor="#888888"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFF4E5"
            android:padding="9dp"
            android:text="原理：在 system_server 中向 DisplayTransformManager 注入全局色彩矩阵。零延迟、零耗电、开机自动生效。\n\n局限：矩阵只能做线性变换（饱和度/对比/白黑位）。色阶量化、抖动、滤光网格、纸纹是非线性的，需另走 GPU shader 方案。"
            android:textColor="#7A5B1E"
            android:textSize="11.5sp"
            android:lineSpacingExtra="2dp" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="关闭墨水屏效果" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="预设"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgPreset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="微调（会覆盖预设）"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lbSat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="饱和度：0.45"
            android:textColor="#333333"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sbSat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/lbBlack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="黑位（墨黑）"
            android:textColor="#333333"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sbBlack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="60" />

        <TextView
            android:id="@+id/lbWhite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="白位（纸白）"
            android:textColor="#333333"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sbWhite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="40" />

        <Button
            android:id="@+id/btnApply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="应用微调（立即生效）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="按 App 切黑白档"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="列出的包名在使用时自动切到「黑白纸质」档（更亮更锐利，适合阅读类 App）。"
            android:textColor="#888888"
            android:textSize="11.5sp" />

        <EditText
            android:id="@+id/etPkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="包名，如 com.tencent.weread"
            android:inputType="text"
            android:textSize="13sp"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAddPkg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="加入" />

            <Button
                android:id="@+id/btnClearPkg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="清空" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPkgs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="（空）"
            android:textColor="#666666"
            android:textSize="11.5sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="诊断"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTestRaw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="测试 1015：直接下发矩阵（看屏幕是否变化）" />

        <Button
            android:id="@+id/btnResetRaw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="恢复：1015 i32 0" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="#555555"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp" />
    </LinearLayout>
</ScrollView>
