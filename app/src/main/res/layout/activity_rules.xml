<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3EE"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#EDE9E0"
        android:fitsSystemWindows="true"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="按 App 指定模式"
        app:titleTextColor="#222222" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#EAF3EC"
                android:padding="10dp"
                android:text="给 App 单独指定显示模式，切到前台时自动换档。\n\n例：相机设「原色」保证取色准确；微信读书设「墨纸」长时间阅读；绘本 App 设「彩纸」。\n\n这比手动切方便 —— 联想那台三模还得自己点。"
                android:textColor="#2C5F3D"
                android:textSize="11.5sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/tvPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FFF4E5"
                android:padding="10dp"
                android:text=""
                android:textColor="#7A5B1E"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <!-- 选模式 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="① 选这个 App 用哪个模式"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnModePick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="墨纸模式  ▼" />

            <TextView
                android:id="@+id/tvModeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="#888888"
                android:textSize="11sp" />

            <!-- 输入包名 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="② 填包名"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPkg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="如 com.tencent.weread"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="加入" />
            </LinearLayout>

            <!-- 快捷添加 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="常见 App 快捷设置"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="点一下弹窗选模式；已设置的会显示当前档位"
                android:textColor="#888888"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/boxQuick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- 已生效名单 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="已生效规则"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPkgs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#FFFFFF"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:text="（空）"
                android:textColor="#555555"
                android:textSize="11.5sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#C0392B"
                android:text="清空全部规则"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
